# ==========================================================
# 1. TELEGRAM USERBOT (ДЛЯ ПАРСИНГА ОТКРЫТЫХ И ЗАКРЫТЫХ КАНАЛОВ)
# Получить на https://my.telegram.org -> API development tools
# Совет: для безопасности используйте дополнительный аккаунт Telegram
# ==========================================================
TG_API_ID=12345678
TG_API_HASH=your_api_hash_from_my_telegram_org
TG_SESSION_NAME=userbot_reader

# ==========================================================
# 2. TELEGRAM BOT (АДМИНКА + ПРЕДЛОЖКА + ПУБЛИКАЦИЯ В КАНАЛ)
# Создайте бота у @BotFather и добавьте его АДМИНИСТРАТОРОМ в ваш канал!
# ==========================================================
BOT_TOKEN=1234567890:AAH_your_bot_token_here

# Ваш личный числовой Telegram ID (можно узнать у @userinfobot).
# Если админов несколько — укажите через запятую: 123456789,987654321
ADMIN_IDS=123456789

# Ваш целевой канал, куда будут публиковаться посты:
# Например @my_awesome_channel или числовой ID закрытого канала -1001234567890
TARGET_CHANNEL=@my_awesome_channel

# ==========================================================
# 3. НАСТРОЙКИ НЕЙРОСЕТИ (УНИВЕРСАЛЬНЫЕ)
# Доступные варианты AI_PROVIDER:
#   gemini     — Google Gemini API (есть бесплатный тариф в Google AI Studio!)
#   openai     — OpenAI API (gpt-4o-mini / gpt-4o)
#   openrouter — OpenRouter.ai (любые модели, включая бесплатные)
#   deepseek   — DeepSeek API (deepseek-chat)
#   groq       — Groq Cloud (очень быстрый бесплатный тариф)
#   custom     — Любой совместимый с OpenAI сервер (например, локальная Ollama)
# ==========================================================
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here

# Необязательные поля (если оставить пустыми — подставятся оптимальные по умолчанию):
AI_MODEL=
AI_BASE_URL=

# Максимальный размер скачиваемого видео (МБ). Лимит Telegram Bot API = 50 МБ
MAX_MEDIA_SIZE_MB=45
